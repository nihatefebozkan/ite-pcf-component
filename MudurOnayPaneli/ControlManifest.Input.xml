<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="ITE" constructor="MudurOnayPaneli" version="1.0.4" display-name-key="Mudur Onay Paneli" description-key="Mudurun onayini bekleyen talepleri gosterir ve gerekce ile karar vermesini saglar." control-type="virtual" >
    <!-- Veri Dataverse dataset'i ve Web API uzerinden gelir; harici servis yok. -->
    <external-service-usage enabled="false">
    </external-service-usage>

    <!-- "Onayimi Bekleyenler" gorunumune baglanir. Gorunumun sutun listesinde
         TalepMetni, UrunTipi, Oncelik, Durum, AIGuvenSkoru, Calisan ve
         Olusturulma Tarihi bulunmalidir; dataset yalnizca gorunumdeki
         sutunlari tasir. -->
    <data-set name="talepler" display-name-key="Talepler">
    </data-set>

    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/MudurOnayPaneli.css" order="1" />
      <platform-library name="React" version="16.14.0" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
